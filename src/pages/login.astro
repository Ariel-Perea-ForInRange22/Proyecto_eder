---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Login">
  <div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-pink-200 via-rose-100 to-purple-200">
    <div class="bg-white p-8 rounded-3xl shadow-2xl w-full max-w-md border-4 border-pink-200">
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold bg-gradient-to-r from-pink-500 to-purple-500 bg-clip-text text-transparent mb-2">🏥 Sistema Veterinaria</h1>
        <p class="text-rose-600 font-medium">✨ Iniciar Sesión</p>
      </div>

      <form id="loginForm" class="space-y-6">
        <div>
          <label class="block text-rose-700 font-bold mb-2">👤 Usuario</label>
          <input
            type="text"
            id="username"
            required
            class="w-full px-4 py-3 border-2 border-pink-200 rounded-xl focus:ring-4 focus:ring-pink-300 focus:border-pink-400 outline-none transition"
            placeholder="Ingrese su usuario"
          />
        </div>

        <div>
          <label class="block text-rose-700 font-bold mb-2">🔒 Contraseña</label>
          <input
            type="password"
            id="password"
            required
            class="w-full px-4 py-3 border-2 border-pink-200 rounded-xl focus:ring-4 focus:ring-pink-300 focus:border-pink-400 outline-none transition"
            placeholder="Ingrese su contraseña"
          />
        </div>

        <div id="errorMsg" class="hidden bg-rose-100 border-2 border-rose-300 text-rose-700 px-4 py-3 rounded-xl font-medium"></div>

        <button
          type="submit"
          class="w-full bg-gradient-to-r from-pink-500 to-rose-500 hover:from-pink-600 hover:to-rose-600 text-white font-bold py-3 px-4 rounded-xl transition transform hover:scale-105 shadow-lg"
        >
          💖 Iniciar Sesión
        </button>

        <div class="text-center">
          <p class="text-gray-600">
            ¿No tienes cuenta?
            <a href="/registro" class="text-pink-600 hover:text-pink-700 font-medium">🌸 Regístrate aquí</a>
          </p>
        </div>

        <div class="text-xs text-rose-600 bg-gradient-to-r from-pink-50 to-rose-50 p-4 rounded-xl border-2 border-pink-200">
          <p class="font-bold mb-2">✨ Usuarios de prueba:</p>
          <p class="mb-1">👑 Admin: <code class="bg-white px-2 py-1 rounded">admin / admin123</code></p>
          <p>👨‍⚕️ Veterinario: <code class="bg-white px-2 py-1 rounded">vet1 / vet123</code></p>
        </div>
      </form>
    </div>
  </div>

  <script>
    import { storage } from '../lib/storage';
    import { Auth } from '../lib/auth';

    // Inicializar datos
    storage.init();

    const loginForm = document.getElementById('loginForm') as HTMLFormElement;
    const errorMsg = document.getElementById('errorMsg') as HTMLDivElement;

    loginForm.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const username = (document.getElementById('username') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;

      const usuario = Auth.login(username, password);

      if (usuario) {
        window.location.href = '/dashboard';
      } else {
        errorMsg.textContent = 'Usuario o contraseña incorrectos';
        errorMsg.classList.remove('hidden');
      }
    });
  </script>
</Layout>
