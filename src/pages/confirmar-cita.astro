---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Confirmar Cita">
  <div class="min-h-screen bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 flex items-center justify-center p-4">
    <div class="max-w-2xl w-full">
      <!-- Contenedor de carga -->
      <div id="loadingContainer" class="bg-white p-8 rounded-3xl shadow-2xl border-4 border-blue-200 text-center">
        <div class="text-6xl mb-4">⏳</div>
        <h2 class="text-2xl font-bold text-gray-800 mb-2">Cargando información...</h2>
        <p class="text-gray-600">Por favor espera un momento</p>
      </div>

      <!-- Contenedor de cita no encontrada -->
      <div id="notFoundContainer" class="hidden bg-white p-8 rounded-3xl shadow-2xl border-4 border-red-200 text-center">
        <div class="text-6xl mb-4">❌</div>
        <h2 class="text-3xl font-bold text-red-600 mb-4">Cita No Encontrada</h2>
        <p class="text-gray-600 mb-6">El enlace de confirmación no es válido o la cita ya no existe.</p>
        <a href="/" class="inline-block bg-gradient-to-r from-blue-500 to-indigo-500 hover:from-blue-600 hover:to-indigo-600 text-white font-bold py-3 px-8 rounded-2xl transition shadow-lg">
          Ir al Inicio
        </a>
      </div>

      <!-- Contenedor de cita encontrada -->
      <div id="citaContainer" class="hidden bg-white p-8 rounded-3xl shadow-2xl border-4 border-blue-200">
        <div class="text-center mb-6">
          <div class="text-6xl mb-4" id="iconoCita">📅</div>
          <h2 class="text-3xl font-bold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
            Confirmación de Cita Veterinaria
          </h2>
        </div>

        <!-- Detalles de la cita -->
        <div class="bg-gradient-to-r from-blue-50 to-indigo-50 p-6 rounded-2xl border-2 border-blue-200 mb-6">
          <h3 class="font-bold text-blue-700 mb-4 text-lg">📋 Detalles de tu Cita:</h3>
          <div id="detallesCita" class="space-y-3">
            <!-- Se llenará con JavaScript -->
          </div>
        </div>

        <!-- Botones de acción -->
        <div id="botonesConfirmacion" class="space-y-3">
          <button
            id="btnConfirmar"
            class="w-full bg-gradient-to-r from-green-500 to-emerald-500 hover:from-green-600 hover:to-emerald-600 text-white font-bold py-4 px-8 rounded-2xl transition shadow-lg transform hover:scale-105"
          >
            ✅ Confirmar mi Asistencia
          </button>
          <button
            id="btnCancelar"
            class="w-full bg-gradient-to-r from-red-400 to-rose-500 hover:from-red-500 hover:to-rose-600 text-white font-bold py-4 px-8 rounded-2xl transition shadow-lg transform hover:scale-105"
          >
            ❌ No Podré Asistir
          </button>
        </div>

        <!-- Mensaje de confirmación exitosa -->
        <div id="mensajeExito" class="hidden">
          <div class="bg-gradient-to-r from-green-50 to-emerald-50 p-6 rounded-2xl border-2 border-green-300 text-center">
            <div class="text-6xl mb-4">✅</div>
            <h3 class="text-2xl font-bold text-green-700 mb-3">¡Cita Confirmada!</h3>
            <p class="text-gray-700 mb-4">Gracias por confirmar tu asistencia. Te esperamos en la fecha y hora indicadas.</p>
            <p class="text-sm text-gray-600">
              <strong>Importante:</strong> Si necesitas cancelar o reprogramar, por favor contacta a la veterinaria lo antes posible.
            </p>
          </div>
        </div>

        <!-- Mensaje de cancelación -->
        <div id="mensajeCancelacion" class="hidden">
          <div class="bg-gradient-to-r from-red-50 to-rose-50 p-6 rounded-2xl border-2 border-red-300 text-center">
            <div class="text-6xl mb-4">❌</div>
            <h3 class="text-2xl font-bold text-red-700 mb-3">Cita Cancelada</h3>
            <p class="text-gray-700 mb-4">Tu cita ha sido cancelada. Te recomendamos contactar a la veterinaria para reprogramarla.</p>
          </div>
        </div>

        <!-- Mensaje si ya fue confirmada -->
        <div id="mensajeYaConfirmada" class="hidden">
          <div class="bg-gradient-to-r from-blue-50 to-indigo-50 p-6 rounded-2xl border-2 border-blue-300 text-center">
            <div class="text-6xl mb-4">ℹ️</div>
            <h3 class="text-2xl font-bold text-blue-700 mb-3">Esta Cita Ya Fue Procesada</h3>
            <p class="text-gray-700 mb-2" id="estadoActual"></p>
            <p class="text-sm text-gray-600 mt-4">
              Si necesitas hacer cambios, por favor contacta directamente a la veterinaria.
            </p>
          </div>
        </div>
      </div>

      <!-- Información de contacto -->
      <div id="infoContacto" class="hidden mt-6 bg-white p-6 rounded-2xl shadow-xl border-2 border-purple-200 text-center">
        <h4 class="font-bold text-purple-700 mb-3">📞 ¿Necesitas Ayuda?</h4>
        <p class="text-gray-600 text-sm" id="contactoVeterinaria">
          <!-- Se llenará con JavaScript -->
        </p>
      </div>
    </div>
  </div>

  <script>
    import { storage } from '../lib/storage';

    storage.init();

    // Obtener token de la URL
    const urlParams = new URLSearchParams(window.location.search);
    const token = urlParams.get('token') || window.location.pathname.split('/').pop();

    const loadingContainer = document.getElementById('loadingContainer')!;
    const notFoundContainer = document.getElementById('notFoundContainer')!;
    const citaContainer = document.getElementById('citaContainer')!;
    const detallesCitaDiv = document.getElementById('detallesCita')!;
    const botonesConfirmacion = document.getElementById('botonesConfirmacion')!;
    const mensajeExito = document.getElementById('mensajeExito')!;
    const mensajeCancelacion = document.getElementById('mensajeCancelacion')!;
    const mensajeYaConfirmada = document.getElementById('mensajeYaConfirmada')!;
    const infoContacto = document.getElementById('infoContacto')!;

    function formatearFecha(fechaISO: string): string {
      const fecha = new Date(fechaISO + 'T00:00:00');
      return fecha.toLocaleDateString('es-MX', { 
        weekday: 'long', 
        year: 'numeric', 
        month: 'long', 
        day: 'numeric' 
      });
    }

    function cargarCita() {
      if (!token) {
        loadingContainer.classList.add('hidden');
        notFoundContainer.classList.remove('hidden');
        return;
      }

      // Buscar la cita por token
      const todasCitas = storage.getCitas();
      const cita = todasCitas.find(c => c.tokenConfirmacion === token);

      if (!cita) {
        loadingContainer.classList.add('hidden');
        notFoundContainer.classList.remove('hidden');
        return;
      }

      // Obtener información relacionada
      const clientes = storage.getClientes();
      const mascotas = storage.getMascotas();
      const veterinarias = JSON.parse(localStorage.getItem('vet_system_veterinarias') || '[]');
      
      const cliente = clientes.find(c => c.id === cita.clienteId);
      const mascota = mascotas.find(m => m.id === cita.mascotaId);
      const veterinaria = veterinarias.find((v: any) => v.id === cita.veterinariaId);

      // Mostrar detalles
      detallesCitaDiv.innerHTML = `
        <div class="bg-white p-4 rounded-xl">
          <p class="font-semibold text-gray-700">👤 Cliente</p>
          <p class="text-gray-600">${cliente?.nombre || 'N/A'}</p>
        </div>
        <div class="bg-white p-4 rounded-xl">
          <p class="font-semibold text-gray-700">🐾 Mascota</p>
          <p class="text-gray-600">${mascota?.nombre || 'N/A'} - ${mascota?.especie || 'N/A'}</p>
        </div>
        <div class="bg-white p-4 rounded-xl">
          <p class="font-semibold text-gray-700">📅 Fecha</p>
          <p class="text-gray-600">${formatearFecha(cita.fecha)}</p>
        </div>
        <div class="bg-white p-4 rounded-xl">
          <p class="font-semibold text-gray-700">⏰ Hora</p>
          <p class="text-lg font-bold text-blue-600">${cita.hora}</p>
        </div>
        <div class="bg-white p-4 rounded-xl">
          <p class="font-semibold text-gray-700">📝 Motivo</p>
          <p class="text-gray-600">${cita.motivo}</p>
        </div>
        <div class="bg-white p-4 rounded-xl">
          <p class="font-semibold text-gray-700">📊 Estado Actual</p>
          <p class="text-gray-600 font-bold">${cita.estado}</p>
        </div>
      `;

      // Mostrar información de contacto
      if (veterinaria) {
        document.getElementById('contactoVeterinaria')!.innerHTML = `
          <strong>${veterinaria.nombre}</strong><br/>
          📍 ${veterinaria.direccion}<br/>
          📞 ${veterinaria.telefono}
        `;
        infoContacto.classList.remove('hidden');
      }

      loadingContainer.classList.add('hidden');
      citaContainer.classList.remove('hidden');

      // Verificar si ya fue confirmada o cancelada
      if (cita.estado === 'Confirmada') {
        botonesConfirmacion.classList.add('hidden');
        mensajeYaConfirmada.classList.remove('hidden');
        document.getElementById('estadoActual')!.textContent = 
          cita.fechaConfirmacion 
            ? `Confirmada el ${new Date(cita.fechaConfirmacion).toLocaleDateString('es-MX')}` 
            : 'Esta cita ya fue confirmada anteriormente.';
        document.getElementById('iconoCita')!.textContent = '✅';
      } else if (cita.estado === 'Cancelada') {
        botonesConfirmacion.classList.add('hidden');
        mensajeYaConfirmada.classList.remove('hidden');
        document.getElementById('estadoActual')!.textContent = 'Esta cita fue cancelada.';
        document.getElementById('iconoCita')!.textContent = '❌';
      } else if (cita.estado === 'Completada') {
        botonesConfirmacion.classList.add('hidden');
        mensajeYaConfirmada.classList.remove('hidden');
        document.getElementById('estadoActual')!.textContent = 'Esta cita ya fue completada.';
        document.getElementById('iconoCita')!.textContent = '✔️';
      }

      // Botón confirmar
      document.getElementById('btnConfirmar')!.addEventListener('click', () => {
        storage.updateCita(cita.id, {
          estado: 'Confirmada',
          fechaConfirmacion: new Date().toISOString()
        });
        botonesConfirmacion.classList.add('hidden');
        mensajeExito.classList.remove('hidden');
        document.getElementById('iconoCita')!.textContent = '✅';
      });

      // Botón cancelar
      document.getElementById('btnCancelar')!.addEventListener('click', () => {
        if (confirm('¿Estás seguro de que no podrás asistir a esta cita?')) {
          storage.updateCita(cita.id, {
            estado: 'Cancelada'
          });
          botonesConfirmacion.classList.add('hidden');
          mensajeCancelacion.classList.remove('hidden');
          document.getElementById('iconoCita')!.textContent = '❌';
        }
      });
    }

    // Cargar la cita al cargar la página
    setTimeout(() => {
      cargarCita();
    }, 500);
  </script>
</Layout>
