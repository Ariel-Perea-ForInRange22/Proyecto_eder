---
import DashboardLayout from '../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Dashboard">
  <div class="space-y-6">
    <div class="bg-gradient-to-r from-pink-100 via-rose-100 to-purple-100 p-8 rounded-3xl shadow-xl border-4 border-pink-200">
      <h2 class="text-3xl font-bold bg-gradient-to-r from-pink-600 to-purple-600 bg-clip-text text-transparent mb-4">💖 Bienvenido al Sistema</h2>
      <div class="space-y-2">
        <p class="text-rose-700 text-lg">👤 Usuario: <span id="userName" class="font-bold"></span></p>
        <p class="text-purple-700 text-lg">📞 Teléfono: <span id="userTelefono" class="font-bold"></span></p>
        <p class="text-purple-700 text-lg">⭐ Rol: <span id="userRole" class="font-bold"></span></p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Tarjeta Clientes -->
      <a href="/clientes" class="block bg-gradient-to-br from-pink-400 to-rose-500 p-8 rounded-3xl shadow-2xl hover:shadow-pink-300 transition transform hover:scale-105 border-4 border-pink-200">
        <div class="text-white">
          <div class="flex items-center justify-between mb-4">
            <div class="text-6xl drop-shadow-lg">👥</div>
            <div class="text-right">
              <div class="text-4xl font-bold drop-shadow-lg" id="clientesCount">0</div>
              <div class="text-pink-100 text-lg">Clientes</div>
            </div>
          </div>
          <div class="border-t-2 border-pink-300 pt-4">
            <p class="font-bold text-lg">✨ Gestión de Clientes</p>
            <p class="text-sm text-pink-100 mt-1">Crear, editar, eliminar y buscar clientes</p>
          </div>
        </div>
      </a>

      <!-- Tarjeta Mascotas -->
      <a href="/mascotas" class="block bg-gradient-to-br from-purple-400 to-pink-500 p-8 rounded-3xl shadow-2xl hover:shadow-purple-300 transition transform hover:scale-105 border-4 border-purple-200">
        <div class="text-white">
          <div class="flex items-center justify-between mb-4">
            <div class="text-6xl drop-shadow-lg">🐾</div>
            <div class="text-right">
              <div class="text-4xl font-bold drop-shadow-lg" id="mascotasCount">0</div>
              <div class="text-purple-100 text-lg">Mascotas</div>
            </div>
          </div>
          <div class="border-t-2 border-purple-300 pt-4">
            <p class="font-bold text-lg">💖 Gestión de Mascotas</p>
            <p class="text-sm text-purple-100 mt-1">Crear, editar, eliminar y buscar mascotas</p>
          </div>
        </div>
      </a>
    </div>

    <!-- Actividad Reciente -->
    <div class="bg-white p-8 rounded-3xl shadow-xl border-4 border-rose-200">
      <h3 class="text-2xl font-bold bg-gradient-to-r from-pink-600 to-purple-600 bg-clip-text text-transparent mb-6">📊 Resumen del Sistema</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-gradient-to-br from-pink-100 to-rose-100 p-6 rounded-2xl shadow-lg border-2 border-pink-200">
          <div class="text-pink-700 text-sm font-bold mb-2">👥 Total Clientes</div>
          <div class="text-4xl font-bold text-rose-600" id="totalClientes">0</div>
        </div>
        <div class="bg-gradient-to-br from-purple-100 to-pink-100 p-6 rounded-2xl shadow-lg border-2 border-purple-200">
          <div class="text-purple-700 text-sm font-bold mb-2">🐾 Total Mascotas</div>
          <div class="text-4xl font-bold text-purple-600" id="totalMascotas">0</div>
        </div>
        <div class="bg-gradient-to-br from-rose-100 to-pink-100 p-6 rounded-2xl shadow-lg border-2 border-rose-200">
          <div class="text-rose-700 text-sm font-bold mb-2">⭐ Veterinarios</div>
          <div class="text-4xl font-bold text-rose-600" id="totalVeterinarios">0</div>
        </div>
      </div>
    </div>

    <!-- Información del Sistema -->
    <div class="bg-gradient-to-r from-purple-100 via-pink-100 to-rose-100 p-6 rounded-3xl shadow-xl border-4 border-purple-200">
      <h3 class="text-xl font-bold text-purple-700 mb-4">💡 Funcionalidades del Sistema</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
        <div class="bg-white p-4 rounded-xl">
          <p class="font-bold text-pink-600 mb-2">✅ Validaciones Activas:</p>
          <ul class="text-gray-700 space-y-1">
            <li>• No permite teléfonos duplicados</li>
            <li>• No permite emails duplicados</li>
            <li>• Advertencia al eliminar clientes con mascotas</li>
          </ul>
        </div>
        <div class="bg-white p-4 rounded-xl">
          <p class="font-bold text-purple-600 mb-2">🔍 Filtros Disponibles:</p>
          <ul class="text-gray-700 space-y-1">
            <li>• Búsqueda de clientes por nombre/teléfono</li>
            <li>• Filtro de mascotas por cliente</li>
            <li>• Filtro de mascotas por especie</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { storage } from '../lib/storage';
    import { Auth } from '../lib/auth';

    storage.init();

    // Obtener información del usuario
    const session = Auth.getSession();
    if (session) {
      const userNameEl = document.getElementById('userName');
      const userTelefonoEl = document.getElementById('userTelefono');
      const userRoleEl = document.getElementById('userRole');
      if (userNameEl) userNameEl.textContent = session.nombre;
      if (userTelefonoEl) userTelefonoEl.textContent = session.telefono || 'No registrado';
      if (userRoleEl) userRoleEl.textContent = session.rol === 'admin' ? 'Administrador' : 'Veterinario';

      // Obtener estadísticas
      const clientes = storage.getClientes(session.veterinariaId);
      const mascotas = storage.getMascotas(session.veterinariaId);
      const usuarios = storage.getUsuarios().filter(u => u.veterinariaId === session.veterinariaId);

      // Actualizar contadores
      const clientesCountEl = document.getElementById('clientesCount');
      const mascotasCountEl = document.getElementById('mascotasCount');
      const totalClientesEl = document.getElementById('totalClientes');
      const totalMascotasEl = document.getElementById('totalMascotas');
      const totalVeterinariosEl = document.getElementById('totalVeterinarios');

      if (clientesCountEl) clientesCountEl.textContent = clientes.length.toString();
      if (mascotasCountEl) mascotasCountEl.textContent = mascotas.length.toString();
      if (totalClientesEl) totalClientesEl.textContent = clientes.length.toString();
      if (totalMascotasEl) totalMascotasEl.textContent = mascotas.length.toString();
      if (totalVeterinariosEl) totalVeterinariosEl.textContent = usuarios.length.toString();
    }
  </script>
</DashboardLayout>
