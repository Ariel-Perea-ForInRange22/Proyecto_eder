---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mi Cuenta">
  <div class="min-h-screen bg-gradient-to-br from-pink-50 via-rose-50 to-purple-50">
    <!-- Header -->
    <nav class="bg-gradient-to-r from-pink-400 via-rose-400 to-purple-400 text-white shadow-2xl">
      <div class="container mx-auto px-4 py-4">
        <div class="flex justify-between items-center">
          <h1 class="text-2xl font-bold drop-shadow-lg">🐾 Mi Cuenta</h1>
          <button id="logoutBtn" class="bg-rose-600 hover:bg-rose-700 px-4 py-2 rounded-xl transition shadow-lg">
            ✨ Cerrar Sesión
          </button>
        </div>
      </div>
    </nav>

    <main class="container mx-auto px-4 py-8">
      <div class="space-y-6">
        <!-- Información del Usuario -->
        <div class="bg-gradient-to-r from-pink-100 via-rose-100 to-purple-100 p-8 rounded-3xl shadow-xl border-4 border-pink-200">
          <h2 class="text-3xl font-bold bg-gradient-to-r from-pink-600 to-purple-600 bg-clip-text text-transparent mb-4">👤 Bienvenido</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="bg-white p-4 rounded-2xl">
              <p class="text-sm text-gray-600">Nombre</p>
              <p class="text-lg font-bold text-gray-800" id="userName"></p>
            </div>
            <div class="bg-white p-4 rounded-2xl">
              <p class="text-sm text-gray-600">Teléfono</p>
              <p class="text-lg font-bold text-gray-800" id="userTelefono"></p>
            </div>
            <div class="bg-white p-4 rounded-2xl">
              <p class="text-sm text-gray-600">Email</p>
              <p class="text-lg font-bold text-gray-800" id="userEmail"></p>
            </div>
            <div class="bg-white p-4 rounded-2xl">
              <p class="text-sm text-gray-600">Dirección</p>
              <p class="text-lg font-bold text-gray-800" id="userDireccion"></p>
            </div>
          </div>
        </div>

        <!-- Resumen -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Tarjeta Mis Mascotas -->
          <div class="bg-gradient-to-br from-purple-400 to-pink-500 p-8 rounded-3xl shadow-2xl border-4 border-purple-200">
            <div class="text-white">
              <div class="flex items-center justify-between mb-4">
                <div class="text-6xl drop-shadow-lg">🐾</div>
                <div class="text-right">
                  <div class="text-4xl font-bold drop-shadow-lg" id="mascotasCount">0</div>
                  <div class="text-purple-100 text-lg">Mis Mascotas</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Tarjeta Mis Citas -->
          <div class="bg-gradient-to-br from-blue-400 to-indigo-500 p-8 rounded-3xl shadow-2xl border-4 border-blue-200">
            <div class="text-white">
              <div class="flex items-center justify-between mb-4">
                <div class="text-6xl drop-shadow-lg">📅</div>
                <div class="text-right">
                  <div class="text-4xl font-bold drop-shadow-lg" id="citasCount">0</div>
                  <div class="text-blue-100 text-lg">Citas Activas</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Tarjeta Catálogo de Productos -->
          <a href="/catalogo" class="block bg-gradient-to-br from-green-400 to-teal-500 p-8 rounded-3xl shadow-2xl hover:shadow-green-300 transition transform hover:scale-105 border-4 border-green-200">
            <div class="text-white">
              <div class="flex items-center justify-between mb-4">
                <div class="text-6xl drop-shadow-lg">🛒</div>
                <div class="text-right">
                  <div class="text-2xl font-bold drop-shadow-lg">Explorar</div>
                  <div class="text-green-100 text-lg">Productos</div>
                </div>
              </div>
              <div class="mt-4 bg-white bg-opacity-20 rounded-2xl p-3 backdrop-blur-sm">
                <p class="text-sm text-center font-medium">Ver catálogo completo →</p>
              </div>
            </div>
          </a>
        </div>

        <!-- Mis Mascotas -->
        <div class="bg-white p-8 rounded-3xl shadow-xl border-4 border-purple-200">
          <h3 class="text-2xl font-bold bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent mb-6">🐾 Mis Mascotas</h3>
          <div id="mascotasList" class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Las mascotas se cargarán aquí -->
          </div>
        </div>

        <!-- Mis Citas -->
        <div class="bg-white p-8 rounded-3xl shadow-xl border-4 border-blue-200">
          <h3 class="text-2xl font-bold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent mb-6">📅 Mis Citas Próximas</h3>
          <div id="citasList" class="space-y-4">
            <!-- Las citas se cargarán aquí -->
          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    import { storage } from '../lib/storage';
    import { Auth } from '../lib/auth';
    import type { Mascota, Cita } from '../lib/types';

    storage.init();

    const session = Auth.getSession();
    if (!session || session.rol !== 'cliente') {
      window.location.href = '/';
    }

    // Obtener emoji según especie
    function getEmojiEspecie(especie: string): string {
      const emojis: { [key: string]: string } = {
        'Perro': '🐕',
        'Gato': '🐈',
        'Ave': '🦜',
        'Conejo': '🐰',
        'Hámster': '🐹',
        'Reptil': '🦎',
        'Otro': '🐾'
      };
      return emojis[especie] || '🐾';
    }

    // Obtener emoji según estado
    function getEmojiEstado(estado: string): string {
      const emojis: { [key: string]: string } = {
        'Pendiente': '⏳',
        'Confirmada': '✅',
        'Completada': '✔️',
        'Cancelada': '❌'
      };
      return emojis[estado] || '📅';
    }

    // Obtener color según estado
    function getColorEstado(estado: string): string {
      const colores: { [key: string]: string } = {
        'Pendiente': 'from-yellow-100 to-orange-100 border-yellow-300',
        'Confirmada': 'from-green-100 to-emerald-100 border-green-300',
        'Completada': 'from-blue-100 to-cyan-100 border-blue-300',
        'Cancelada': 'from-red-100 to-rose-100 border-red-300'
      };
      return colores[estado] || 'from-gray-100 to-slate-100 border-gray-300';
    }

    // Formatear fecha
    function formatearFecha(fechaISO: string): string {
      const fecha = new Date(fechaISO + 'T00:00:00');
      return fecha.toLocaleDateString('es-MX', { 
        weekday: 'long', 
        year: 'numeric', 
        month: 'long', 
        day: 'numeric' 
      });
    }

    // Cargar información del usuario
    const clientes = storage.getClientes(session!.veterinariaId);
    const cliente = clientes.find(c => c.id === session!.clienteId);

    if (cliente) {
      document.getElementById('userName')!.textContent = cliente.nombre;
      document.getElementById('userTelefono')!.textContent = cliente.telefono || 'No registrado';
      document.getElementById('userEmail')!.textContent = cliente.email || 'No registrado';
      document.getElementById('userDireccion')!.textContent = cliente.direccion || 'No registrada';
    }

    // Cargar mascotas del cliente
    const mascotas = storage.getMascotasByCliente(session!.clienteId!);
    document.getElementById('mascotasCount')!.textContent = mascotas.length.toString();

    const mascotasList = document.getElementById('mascotasList')!;
    if (mascotas.length === 0) {
      mascotasList.innerHTML = '<p class="col-span-2 text-purple-500 text-center py-8 font-medium">🐾 No tienes mascotas registradas aún. Contacta a la veterinaria para registrar tus mascotas.</p>';
    } else {
      mascotasList.innerHTML = mascotas.map(mascota => {
        const emoji = getEmojiEspecie(mascota.especie);
        return `
          <div class="border-4 border-purple-200 bg-gradient-to-br from-purple-50 via-pink-50 to-rose-50 p-6 rounded-2xl hover:shadow-2xl transition">
            <div class="flex items-start gap-4">
              <div class="text-5xl drop-shadow-lg">${emoji}</div>
              <div class="flex-1">
                <h4 class="text-2xl font-bold text-purple-700 mb-3">${mascota.nombre}</h4>
                <div class="space-y-2 text-sm text-gray-700">
                  <p class="bg-white px-3 py-2 rounded-lg"><span class="font-bold">🌿 Especie:</span> ${mascota.especie}</p>
                  ${mascota.raza ? `<p class="bg-white px-3 py-2 rounded-lg"><span class="font-bold">🏆 Raza:</span> ${mascota.raza}</p>` : ''}
                  <p class="bg-white px-3 py-2 rounded-lg"><span class="font-bold">🎂 Edad:</span> ${mascota.edad} ${mascota.edad === 1 ? 'año' : 'años'}</p>
                  ${mascota.observaciones ? `<p class="text-xs bg-yellow-100 border-2 border-yellow-300 p-3 rounded-xl mt-2"><span class="font-bold">📝 Observaciones:</span> ${mascota.observaciones}</p>` : ''}
                </div>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    // Cargar citas del cliente
    const todasCitas = storage.getCitas(session!.veterinariaId);
    const citas = todasCitas.filter(c => c.clienteId === session!.clienteId && 
                                        (c.estado === 'Pendiente' || c.estado === 'Confirmada'));
    
    // Ordenar por fecha
    const citasOrdenadas = citas.sort((a, b) => {
      const fechaA = new Date(a.fecha + 'T' + a.hora);
      const fechaB = new Date(b.fecha + 'T' + b.hora);
      return fechaA.getTime() - fechaB.getTime();
    });

    document.getElementById('citasCount')!.textContent = citasOrdenadas.length.toString();

    const citasList = document.getElementById('citasList')!;
    if (citasOrdenadas.length === 0) {
      citasList.innerHTML = '<p class="text-blue-500 text-center py-8 font-medium">📅 No tienes citas próximas programadas</p>';
    } else {
      citasList.innerHTML = citasOrdenadas.map(cita => {
        const mascota = mascotas.find(m => m.id === cita.mascotaId);
        const emoji = getEmojiEstado(cita.estado);
        const colorClase = getColorEstado(cita.estado);
        const fechaCita = new Date(cita.fecha + 'T' + cita.hora);
        const ahora = new Date();
        const esProxima = fechaCita >= ahora;
        
        return `
          <div class="border-4 bg-gradient-to-br ${colorClase} p-6 rounded-2xl">
            <div class="flex items-start justify-between gap-4">
              <div class="flex items-start gap-4 flex-1">
                <div class="text-5xl drop-shadow-lg">${emoji}</div>
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-3">
                    <h4 class="text-2xl font-bold text-gray-800">${mascota?.nombre || 'Desconocido'}</h4>
                    <span class="bg-white px-3 py-1 rounded-full text-sm font-semibold text-gray-700">${cita.estado}</span>
                    ${esProxima ? '<span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold">PRÓXIMA</span>' : ''}
                  </div>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
                    <div class="bg-white px-4 py-3 rounded-xl">
                      <p class="font-bold text-gray-700">📆 Fecha</p>
                      <p class="text-gray-600">${formatearFecha(cita.fecha)}</p>
                    </div>
                    <div class="bg-white px-4 py-3 rounded-xl">
                      <p class="font-bold text-gray-700">⏰ Hora</p>
                      <p class="text-lg font-bold text-blue-600">${cita.hora}</p>
                    </div>
                    <div class="bg-white px-4 py-3 rounded-xl col-span-2">
                      <p class="font-bold text-gray-700">📝 Motivo</p>
                      <p class="text-gray-600">${cita.motivo}</p>
                    </div>
                  </div>
                  ${cita.observaciones ? `
                    <div class="mt-3 bg-white p-3 rounded-xl border-2 border-blue-200">
                      <p class="text-xs font-bold text-blue-700">💬 Observaciones:</p>
                      <p class="text-sm text-gray-700 mt-1">${cita.observaciones}</p>
                    </div>
                  ` : ''}
                  ${cita.estado === 'Pendiente' && cita.tokenConfirmacion ? `
                    <div class="mt-3 bg-yellow-50 p-3 rounded-xl border-2 border-yellow-300">
                      <p class="text-xs font-bold text-yellow-700 mb-2">⏳ Esta cita está pendiente de confirmación</p>
                      <a href="/confirmar-cita?token=${cita.tokenConfirmacion}" 
                         class="inline-block bg-gradient-to-r from-green-500 to-emerald-500 hover:from-green-600 hover:to-emerald-600 text-white font-bold px-4 py-2 rounded-xl transition text-sm">
                        ✅ Confirmar Cita
                      </a>
                    </div>
                  ` : ''}
                </div>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    // Botón de logout
    document.getElementById('logoutBtn')?.addEventListener('click', () => {
      localStorage.removeItem('vet_session');
      window.location.href = '/';
    });
  </script>
</Layout>
