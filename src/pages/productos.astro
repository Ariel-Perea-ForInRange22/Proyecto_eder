---
import DashboardLayout from '../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Productos">
  <div class="space-y-6">
    <!-- Encabezado -->
    <div class="bg-gradient-to-r from-green-100 via-teal-100 to-cyan-100 p-8 rounded-3xl shadow-xl border-4 border-green-200">
      <div class="flex justify-between items-center">
        <div>
          <h2 class="text-4xl font-bold bg-gradient-to-r from-green-600 to-teal-600 bg-clip-text text-transparent">🛒 Productos Veterinarios</h2>
          <p class="text-teal-600 mt-2 text-lg">✨ Gestiona el inventario de productos</p>
        </div>
        <button
          id="btnNuevoProducto"
          class="bg-gradient-to-r from-green-500 to-teal-500 hover:from-green-600 hover:to-teal-600 text-white font-bold py-4 px-8 rounded-2xl transition transform hover:scale-105 shadow-lg"
        >
          ➕ Nuevo Producto
        </button>
      </div>
    </div>

    <!-- Búsqueda y Filtros -->
    <div class="bg-white p-6 rounded-3xl shadow-xl border-4 border-teal-200">
      <div class="mb-3 flex items-center gap-2 text-teal-600">
        <span class="font-bold">🔍 Filtros de Productos</span>
        <span class="text-sm bg-teal-100 px-3 py-1 rounded-full">Filtra por especie, categoría o búsqueda</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
        <div class="md:col-span-4">
          <input
            type="text"
            id="searchInput"
            placeholder="🔍 Buscar producto..."
            class="w-full px-6 py-4 border-2 border-green-200 rounded-2xl focus:ring-4 focus:ring-green-300 focus:border-green-400 outline-none text-lg"
          />
        </div>
        <div class="md:col-span-3">
          <select
            id="especieFilter"
            class="w-full px-6 py-4 border-2 border-teal-200 rounded-2xl focus:ring-4 focus:ring-teal-300 outline-none bg-gradient-to-r from-teal-50 to-cyan-50 font-medium text-teal-700"
          >
            <option value="">🐾 Todas las especies</option>
            <option value="Perro">🐕 Perro</option>
            <option value="Gato">🐈 Gato</option>
            <option value="Ave">🦜 Ave</option>
            <option value="Conejo">🐰 Conejo</option>
            <option value="Hámster">🐹 Hámster</option>
            <option value="Reptil">🦎 Reptil</option>
            <option value="Otro">🌟 Otro</option>
          </select>
        </div>
        <div class="md:col-span-3">
          <select
            id="categoriaFilter"
            class="w-full px-6 py-4 border-2 border-cyan-200 rounded-2xl focus:ring-4 focus:ring-cyan-300 outline-none bg-gradient-to-r from-cyan-50 to-green-50 font-medium text-green-700"
          >
            <option value="">📦 Todas las categorías</option>
            <option value="Alimento">🍖 Alimentos</option>
            <option value="Higiene">🧼 Higiene</option>
            <option value="Juguetes">🎾 Juguetes</option>
            <option value="Medicamentos">💊 Medicamentos</option>
            <option value="Accesorios">🎀 Accesorios</option>
            <option value="Otro">📌 Otro</option>
          </select>
        </div>
        <div class="md:col-span-2">
          <button
            id="btnVerTodos"
            class="w-full bg-gradient-to-r from-teal-500 to-green-500 hover:from-teal-600 hover:to-green-600 text-white font-bold px-6 py-4 rounded-2xl transition shadow-lg"
          >
            📊 Ver Todos
          </button>
        </div>
      </div>
    </div>

    <!-- Lista de Productos -->
    <div class="bg-white p-8 rounded-3xl shadow-xl border-4 border-green-200">
      <div class="flex justify-between items-center mb-6">
        <h3 class="text-2xl font-bold bg-gradient-to-r from-green-600 to-teal-600 bg-clip-text text-transparent">📋 Inventario</h3>
        <div id="countProductos" class="text-lg font-bold text-teal-600 bg-teal-100 px-4 py-2 rounded-xl"></div>
      </div>
      <div id="productosList" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Los productos se cargarán aquí -->
      </div>
    </div>
  </div>

  <!-- Modal para Crear/Editar Producto -->
  <div id="productoModal" class="hidden fixed inset-0 flex items-center justify-center z-50" style="backdrop-filter: blur(10px); background-color: rgba(0, 0, 0, 0.2);">
    <div class="bg-white p-8 rounded-3xl shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto border-4 border-green-300">
      <div class="flex justify-between items-center mb-6">
        <h3 id="modalTitle" class="text-3xl font-bold bg-gradient-to-r from-green-600 to-teal-600 bg-clip-text text-transparent">🌸 Nuevo Producto</h3>
        <button id="btnCerrarModal" class="text-teal-500 hover:text-teal-700 text-3xl font-bold">✕</button>
      </div>

      <form id="productoForm" class="space-y-4">
        <input type="hidden" id="productoId" />
        
        <div>
          <label class="block text-teal-700 font-bold mb-2">📦 Nombre del Producto *</label>
          <input
            type="text"
            id="nombre"
            required
            class="w-full px-4 py-3 border-2 border-green-200 rounded-xl focus:ring-4 focus:ring-green-300 focus:border-green-400 outline-none"
            placeholder="Ej: Croquetas Premium"
          />
        </div>

        <div>
          <label class="block text-teal-700 font-bold mb-2">📝 Descripción *</label>
          <textarea
            id="descripcion"
            required
            rows="3"
            class="w-full px-4 py-3 border-2 border-green-200 rounded-xl focus:ring-4 focus:ring-green-300 focus:border-green-400 outline-none resize-none"
            placeholder="Descripción del producto..."
          ></textarea>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-teal-700 font-bold mb-2">💰 Precio *</label>
            <input
              type="number"
              id="precio"
              required
              min="0"
              step="0.01"
              class="w-full px-4 py-3 border-2 border-green-200 rounded-xl focus:ring-4 focus:ring-green-300 focus:border-green-400 outline-none"
              placeholder="0.00"
            />
          </div>

          <div>
            <label class="block text-teal-700 font-bold mb-2">📊 Stock *</label>
            <input
              type="number"
              id="stock"
              required
              min="0"
              class="w-full px-4 py-3 border-2 border-green-200 rounded-xl focus:ring-4 focus:ring-green-300 focus:border-green-400 outline-none"
              placeholder="0"
            />
          </div>
        </div>

        <div>
          <label class="block text-teal-700 font-bold mb-2">🗂️ Categoría *</label>
          <select
            id="categoria"
            required
            class="w-full px-4 py-3 border-2 border-green-200 rounded-xl focus:ring-4 focus:ring-green-300 focus:border-green-400 outline-none bg-gradient-to-r from-green-50 to-teal-50"
          >
            <option value="">Seleccionar...</option>
            <option value="Alimento">🍖 Alimento</option>
            <option value="Higiene">🧼 Higiene</option>
            <option value="Juguetes">🎾 Juguetes</option>
            <option value="Medicamentos">💊 Medicamentos</option>
            <option value="Accesorios">🎀 Accesorios</option>
            <option value="Otro">📌 Otro</option>
          </select>
        </div>

        <div>
          <label class="block text-teal-700 font-bold mb-2">🐾 Especies Recomendadas</label>
          <div class="grid grid-cols-2 gap-3 p-4 bg-gradient-to-br from-green-50 to-teal-50 rounded-xl border-2 border-green-200">
            <label class="flex items-center gap-2 cursor-pointer hover:bg-white p-2 rounded-lg transition">
              <input type="checkbox" value="Perro" class="especie-checkbox w-5 h-5 text-green-600 rounded focus:ring-2 focus:ring-green-300" />
              <span class="text-teal-700">🐕 Perro</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer hover:bg-white p-2 rounded-lg transition">
              <input type="checkbox" value="Gato" class="especie-checkbox w-5 h-5 text-green-600 rounded focus:ring-2 focus:ring-green-300" />
              <span class="text-teal-700">🐈 Gato</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer hover:bg-white p-2 rounded-lg transition">
              <input type="checkbox" value="Ave" class="especie-checkbox w-5 h-5 text-green-600 rounded focus:ring-2 focus:ring-green-300" />
              <span class="text-teal-700">🦜 Ave</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer hover:bg-white p-2 rounded-lg transition">
              <input type="checkbox" value="Conejo" class="especie-checkbox w-5 h-5 text-green-600 rounded focus:ring-2 focus:ring-green-300" />
              <span class="text-teal-700">🐰 Conejo</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer hover:bg-white p-2 rounded-lg transition">
              <input type="checkbox" value="Hámster" class="especie-checkbox w-5 h-5 text-green-600 rounded focus:ring-2 focus:ring-green-300" />
              <span class="text-teal-700">🐹 Hámster</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer hover:bg-white p-2 rounded-lg transition">
              <input type="checkbox" value="Reptil" class="especie-checkbox w-5 h-5 text-green-600 rounded focus:ring-2 focus:ring-green-300" />
              <span class="text-teal-700">🦎 Reptil</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer hover:bg-white p-2 rounded-lg transition">
              <input type="checkbox" value="Otro" class="especie-checkbox w-5 h-5 text-green-600 rounded focus:ring-2 focus:ring-green-300" />
              <span class="text-teal-700">🌟 Otro</span>
            </label>
          </div>
          <p class="text-xs text-teal-600 mt-2">💡 Si no seleccionas ninguna, el producto será para todas las especies</p>
        </div>

        <div class="flex gap-4 mt-6">
          <button
            type="submit"
            class="flex-1 bg-gradient-to-r from-green-500 to-teal-500 hover:from-green-600 hover:to-teal-600 text-white font-bold py-4 rounded-2xl transition shadow-lg"
          >
            💖 Guardar
          </button>
          <button
            type="button"
            id="btnCancelar"
            class="flex-1 bg-gradient-to-r from-gray-400 to-gray-500 hover:from-gray-500 hover:to-gray-600 text-white font-bold py-4 rounded-2xl transition shadow-lg"
          >
            ❌ Cancelar
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    import { storage } from '../lib/storage';
    import { Auth } from '../lib/auth';
    import type { Producto } from '../lib/types';

    storage.init();

    const session = Auth.getSession();
    if (!session) {
      window.location.href = '/';
    }

    const modal = document.getElementById('productoModal')!;
    const productoForm = document.getElementById('productoForm') as HTMLFormElement;
    const productosList = document.getElementById('productosList')!;
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const especieFilter = document.getElementById('especieFilter') as HTMLSelectElement;
    const categoriaFilter = document.getElementById('categoriaFilter') as HTMLSelectElement;

    let editandoId: string | null = null;

    // Función para obtener el icono de categoría
    function getIconoCategoria(categoria: string): string {
      const iconos: { [key: string]: string } = {
        'Alimento': '🍖',
        'Higiene': '🧼',
        'Juguetes': '🎾',
        'Medicamentos': '💊',
        'Accesorios': '🎀',
        'Otro': '📌'
      };
      return iconos[categoria] || '📦';
    }

    // Función para renderizar productos
    function renderProductos(productos: Producto[]) {
      const countEl = document.getElementById('countProductos');
      if (countEl) {
        countEl.textContent = `${productos.length} ${productos.length === 1 ? 'producto' : 'productos'}`;
      }

      if (productos.length === 0) {
        productosList.innerHTML = '<p class="col-span-full text-teal-500 text-center py-8 font-medium">🔍 No se encontraron productos con los criterios seleccionados</p>';
        return;
      }

      productosList.innerHTML = productos.map(producto => {
        const stockClass = producto.stock < 10 ? 'bg-red-100 text-red-700 border-red-300' : 
                          producto.stock < 30 ? 'bg-yellow-100 text-yellow-700 border-yellow-300' : 
                          'bg-green-100 text-green-700 border-green-300';
        const especiesTexto = producto.especiesRecomendadas.length === 0 
          ? '🌟 Universal' 
          : producto.especiesRecomendadas.join(', ');
        
        return `
          <div class="border-4 border-green-200 bg-gradient-to-br from-green-50 via-teal-50 to-cyan-50 p-6 rounded-2xl hover:shadow-2xl transition transform hover:scale-105">
            <div class="flex items-start justify-between mb-3">
              <div class="text-4xl drop-shadow-lg">${getIconoCategoria(producto.categoria)}</div>
              <span class="${stockClass} px-3 py-1 rounded-full text-xs font-bold border-2">
                Stock: ${producto.stock}
              </span>
            </div>
            
            <h4 class="text-xl font-bold text-teal-700 mb-2">${producto.nombre}</h4>
            <p class="text-sm text-teal-600 mb-3 line-clamp-2">${producto.descripcion}</p>
            
            <div class="space-y-2 mb-4">
              <div class="flex items-center gap-2 text-sm">
                <span class="font-bold text-green-700">💰 Precio:</span>
                <span class="text-xl font-bold text-green-600">$${producto.precio.toFixed(2)}</span>
              </div>
              <div class="flex items-center gap-2 text-sm">
                <span class="font-bold text-teal-700">🗂️ Categoría:</span>
                <span class="bg-teal-100 px-2 py-1 rounded-lg">${producto.categoria}</span>
              </div>
              <div class="flex items-start gap-2 text-xs">
                <span class="font-bold text-cyan-700">🐾 Para:</span>
                <span class="text-cyan-600 flex-1">${especiesTexto}</span>
              </div>
            </div>
            
            <div class="flex gap-2 mt-4">
              <button
                onclick="editarProducto('${producto.id}')"
                class="flex-1 bg-gradient-to-r from-yellow-400 to-orange-400 hover:from-yellow-500 hover:to-orange-500 text-white px-4 py-2 rounded-xl transition text-sm font-bold shadow-lg"
              >
                ✏️ Editar
              </button>
              <button
                onclick="eliminarProducto('${producto.id}', '${producto.nombre}')"
                class="flex-1 bg-gradient-to-r from-red-400 to-pink-400 hover:from-red-500 hover:to-pink-500 text-white px-4 py-2 rounded-xl transition text-sm font-bold shadow-lg"
              >
                🗑️ Eliminar
              </button>
            </div>
          </div>
        `;
      }).join('');
    }

    // Cargar todos los productos
    function cargarProductos() {
      const productos = storage.getProductos(session!.veterinariaId);
      renderProductos(productos);
    }

    // Filtrar productos
    function filtrarProductos() {
      const termino = searchInput.value.trim();
      const especieFiltro = especieFilter.value;
      const categoriaFiltro = categoriaFilter.value;
      
      let productos = storage.getProductos(session!.veterinariaId);

      // Filtrar por término de búsqueda
      if (termino) {
        productos = storage.buscarProductos(termino, session!.veterinariaId);
      }

      // Filtrar por especie
      if (especieFiltro) {
        productos = productos.filter(p => 
          p.especiesRecomendadas.length === 0 || 
          p.especiesRecomendadas.includes(especieFiltro)
        );
      }

      // Filtrar por categoría
      if (categoriaFiltro) {
        productos = productos.filter(p => p.categoria === categoriaFiltro);
      }

      renderProductos(productos);
    }

    // Abrir modal para nuevo producto
    document.getElementById('btnNuevoProducto')!.addEventListener('click', () => {
      editandoId = null;
      productoForm.reset();
      document.querySelectorAll('.especie-checkbox').forEach((cb: any) => cb.checked = false);
      (document.getElementById('modalTitle') as HTMLElement).textContent = '🌸 Nuevo Producto';
      modal.classList.remove('hidden');
    });

    // Cerrar modal
    function cerrarModal() {
      modal.classList.add('hidden');
      productoForm.reset();
      editandoId = null;
      document.querySelectorAll('.especie-checkbox').forEach((cb: any) => cb.checked = false);
    }

    document.getElementById('btnCerrarModal')!.addEventListener('click', cerrarModal);
    document.getElementById('btnCancelar')!.addEventListener('click', cerrarModal);

    // Guardar producto
    productoForm.addEventListener('submit', (e) => {
      e.preventDefault();

      const nombre = (document.getElementById('nombre') as HTMLInputElement).value;
      const descripcion = (document.getElementById('descripcion') as HTMLTextAreaElement).value;
      const precio = parseFloat((document.getElementById('precio') as HTMLInputElement).value);
      const stock = parseInt((document.getElementById('stock') as HTMLInputElement).value);
      const categoria = (document.getElementById('categoria') as HTMLSelectElement).value as any;
      
      // Obtener especies seleccionadas
      const especiesRecomendadas: string[] = [];
      document.querySelectorAll('.especie-checkbox:checked').forEach((checkbox: any) => {
        especiesRecomendadas.push(checkbox.value);
      });

      if (editandoId) {
        // Actualizar producto existente
        storage.updateProducto(editandoId, {
          nombre,
          descripcion,
          precio,
          stock,
          categoria,
          especiesRecomendadas
        });
      } else {
        // Crear nuevo producto
        const nuevoProducto: Producto = {
          id: `prod-${Date.now()}`,
          nombre,
          descripcion,
          precio,
          stock,
          categoria,
          especiesRecomendadas,
          veterinariaId: session!.veterinariaId
        };
        storage.saveProducto(nuevoProducto);
      }

      cerrarModal();
      cargarProductos();
    });

    // Editar producto
    (window as any).editarProducto = (id: string) => {
      const productos = storage.getProductos(session!.veterinariaId);
      const producto = productos.find(p => p.id === id);
      
      if (producto) {
        editandoId = id;
        (document.getElementById('nombre') as HTMLInputElement).value = producto.nombre;
        (document.getElementById('descripcion') as HTMLTextAreaElement).value = producto.descripcion;
        (document.getElementById('precio') as HTMLInputElement).value = producto.precio.toString();
        (document.getElementById('stock') as HTMLInputElement).value = producto.stock.toString();
        (document.getElementById('categoria') as HTMLSelectElement).value = producto.categoria;
        
        // Marcar especies
        document.querySelectorAll('.especie-checkbox').forEach((checkbox: any) => {
          checkbox.checked = producto.especiesRecomendadas.includes(checkbox.value);
        });
        
        (document.getElementById('modalTitle') as HTMLElement).textContent = 'Editar Producto';
        modal.classList.remove('hidden');
      }
    };

    // Eliminar producto
    (window as any).eliminarProducto = (id: string, nombre: string) => {
      if (confirm(`¿Estás seguro de eliminar "${nombre}"?`)) {
        storage.deleteProducto(id);
        cargarProductos();
      }
    };

    // Eventos de búsqueda y filtros
    searchInput.addEventListener('input', filtrarProductos);
    especieFilter.addEventListener('change', filtrarProductos);
    categoriaFilter.addEventListener('change', filtrarProductos);

    document.getElementById('btnVerTodos')!.addEventListener('click', () => {
      searchInput.value = '';
      especieFilter.value = '';
      categoriaFilter.value = '';
      cargarProductos();
    });

    // Cargar productos al iniciar
    cargarProductos();
  </script>
</DashboardLayout>
