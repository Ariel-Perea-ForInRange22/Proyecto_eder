---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Registro">
  <div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-purple-200 via-pink-100 to-rose-200 py-8">
    <div class="bg-white p-8 rounded-3xl shadow-2xl w-full max-w-md border-4 border-purple-200">
      <div class="text-center mb-6">
        <h1 class="text-3xl font-bold bg-gradient-to-r from-purple-500 to-pink-500 bg-clip-text text-transparent mb-2">🌸 Registro de Usuario</h1>
        <p class="text-purple-600 font-medium">✨ Crear nueva cuenta</p>
      </div>

      <form id="registerForm" class="space-y-4">
        <div>
          <label class="block text-purple-700 font-bold mb-2">👤 Nombre Completo</label>
          <input
            type="text"
            id="nombre"
            required
            class="w-full px-4 py-3 border-2 border-purple-200 rounded-xl focus:ring-4 focus:ring-purple-300 focus:border-purple-400 outline-none transition"
            placeholder="Ej: Dr. Juan Pérez"
          />
        </div>

        <div>
          <label class="block text-purple-700 font-bold mb-2">👤 Usuario</label>
          <input
            type="text"
            id="username"
            required
            class="w-full px-4 py-3 border-2 border-purple-200 rounded-xl focus:ring-4 focus:ring-purple-300 focus:border-purple-400 outline-none transition"
            placeholder="Nombre de usuario"
          />
        </div>

        <div>
          <label class="block text-purple-700 font-bold mb-2">📞 Teléfono</label>
          <input
            type="tel"
            id="telefono"
            required
            class="w-full px-4 py-3 border-2 border-purple-200 rounded-xl focus:ring-4 focus:ring-purple-300 focus:border-purple-400 outline-none transition"
            placeholder="Ej: 555-1234"
          />
        </div>

        <div>
          <label class="block text-purple-700 font-bold mb-2">� Email <span class="text-sm text-gray-500">(opcional)</span></label>
          <input
            type="email"
            id="email"
            class="w-full px-4 py-3 border-2 border-purple-200 rounded-xl focus:ring-4 focus:ring-purple-300 focus:border-purple-400 outline-none transition"
            placeholder="correo@ejemplo.com"
          />
        </div>

        <!-- Campo adicional para clientes -->
        <div id="direccionField" class="hidden">
          <label class="block text-purple-700 font-bold mb-2">📍 Dirección</label>
          <input
            type="text"
            id="direccion"
            class="w-full px-4 py-3 border-2 border-purple-200 rounded-xl focus:ring-4 focus:ring-purple-300 focus:border-purple-400 outline-none transition"
            placeholder="Ej: Calle Principal #123"
          />
        </div>

        <div>
          <label class="block text-purple-700 font-bold mb-2">🔒 Contraseña</label>
          <input
            type="password"
            id="password"
            required
            class="w-full px-4 py-3 border-2 border-purple-200 rounded-xl focus:ring-4 focus:ring-purple-300 focus:border-purple-400 outline-none transition"
            placeholder="Mínimo 6 caracteres"
          />
        </div>

        <div>
          <label class="block text-purple-700 font-bold mb-2">⭐ Tipo de Cuenta</label>
          <select
            id="rol"
            required
            class="w-full px-4 py-3 border-2 border-purple-200 rounded-xl focus:ring-4 focus:ring-purple-300 focus:border-purple-400 outline-none transition bg-gradient-to-r from-purple-50 to-pink-50"
          >
            <option value="cliente">👥 Cliente (Dueño de Mascota)</option>
            <option value="veterinario">🩺 Veterinario</option>
            <option value="admin">⚙️ Administrador</option>
          </select>
        </div>

        <div id="infoCliente" class="hidden bg-blue-50 border-2 border-blue-200 text-blue-700 px-4 py-3 rounded-xl text-sm">
          <p class="font-semibold mb-1">ℹ️ Cuenta de Cliente:</p>
          <p>Podrás ver el estado de tus mascotas, sus citas y confirmar citas asignadas.</p>
        </div>

        <div id="errorMsg" class="hidden bg-rose-100 border-2 border-rose-300 text-rose-700 px-4 py-3 rounded-xl text-sm font-medium"></div>
        <div id="successMsg" class="hidden bg-green-100 border-2 border-green-300 text-green-700 px-4 py-3 rounded-xl text-sm font-medium"></div>

        <button
          type="submit"
          class="w-full bg-gradient-to-r from-purple-500 to-pink-500 hover:from-purple-600 hover:to-pink-600 text-white font-bold py-3 px-4 rounded-xl transition transform hover:scale-105 shadow-lg"
        >
          💖 Registrarse
        </button>

        <div class="text-center">
          <p class="text-gray-600">
            ¿Ya tienes cuenta?
            <a href="/login" class="text-purple-600 hover:text-purple-700 font-medium">✨ Inicia sesión</a>
          </p>
        </div>
      </form>
    </div>
  </div>

  <script>
    import { storage } from '../lib/storage';
    import { Auth } from '../lib/auth';
    import type { Usuario, Cliente } from '../lib/types';

    storage.init();

    const registerForm = document.getElementById('registerForm') as HTMLFormElement;
    const errorMsg = document.getElementById('errorMsg') as HTMLDivElement;
    const successMsg = document.getElementById('successMsg') as HTMLDivElement;
    const rolSelect = document.getElementById('rol') as HTMLSelectElement;
    const direccionField = document.getElementById('direccionField')!;
    const infoCliente = document.getElementById('infoCliente')!;

    // Mostrar/ocultar campos según el rol
    rolSelect.addEventListener('change', () => {
      if (rolSelect.value === 'cliente') {
        direccionField.classList.remove('hidden');
        infoCliente.classList.remove('hidden');
        (document.getElementById('direccion') as HTMLInputElement).required = true;
      } else {
        direccionField.classList.add('hidden');
        infoCliente.classList.add('hidden');
        (document.getElementById('direccion') as HTMLInputElement).required = false;
      }
    });

    registerForm.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const nombre = (document.getElementById('nombre') as HTMLInputElement).value;
      const username = (document.getElementById('username') as HTMLInputElement).value;
      const telefono = (document.getElementById('telefono') as HTMLInputElement).value;
      const email = (document.getElementById('email') as HTMLInputElement).value;
      const direccion = (document.getElementById('direccion') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;
      const rol = (document.getElementById('rol') as HTMLSelectElement).value as 'admin' | 'veterinario' | 'cliente';

      if (password.length < 6) {
        errorMsg.textContent = 'La contraseña debe tener al menos 6 caracteres';
        errorMsg.classList.remove('hidden');
        successMsg.classList.add('hidden');
        return;
      }

      // Verificar si el usuario ya existe
      const usuarios = storage.getUsuarios();
      if (usuarios.some(u => u.username === username)) {
        errorMsg.textContent = 'El nombre de usuario ya existe';
        errorMsg.classList.remove('hidden');
        successMsg.classList.add('hidden');
        return;
      }

      // Verificar si el teléfono ya está registrado
      const telefonoExistente = usuarios.find(u => u.telefono === telefono);
      if (telefonoExistente) {
        errorMsg.textContent = `⚠️ TELÉFONO DUPLICADO\n\nEl número "${telefono}" ya está registrado para:\n\n👤 ${telefonoExistente.nombre}\n\nPor favor, usa otro número de teléfono.`;
        errorMsg.classList.remove('hidden');
        successMsg.classList.add('hidden');
        return;
      }

      try {
        let clienteId: string | undefined = undefined;

        // Si es cliente, crear el registro de cliente primero
        if (rol === 'cliente') {
          if (!direccion) {
            errorMsg.textContent = 'La dirección es obligatoria para clientes';
            errorMsg.classList.remove('hidden');
            successMsg.classList.add('hidden');
            return;
          }

          const nuevoCliente: Cliente = {
            id: `cli-${Date.now()}`,
            nombre,
            telefono,
            email: email || '',
            direccion,
            veterinariaId: 'vet-1',
            fechaRegistro: new Date().toISOString()
          };
          storage.saveCliente(nuevoCliente);
          clienteId = nuevoCliente.id;
        }

        const newUsuario: Omit<Usuario, 'id'> = {
          username,
          password,
          nombre,
          telefono,
          email: email || undefined,
          rol,
          veterinariaId: 'vet-1',
          clienteId
        };

        Auth.register(newUsuario);
        
        successMsg.textContent = 'Registro exitoso. Redirigiendo...';
        successMsg.classList.remove('hidden');
        errorMsg.classList.add('hidden');

        setTimeout(() => {
          if (rol === 'cliente') {
            window.location.href = '/mi-cuenta';
          } else {
            window.location.href = '/dashboard';
          }
        }, 1500);
      } catch (error) {
        errorMsg.textContent = 'Error al registrar usuario';
        errorMsg.classList.remove('hidden');
        successMsg.classList.add('hidden');
      }
    });
  </script>
</Layout>
