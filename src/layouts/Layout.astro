---
interface Props {
  title: string;
}

const { title } = Astro.props;
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} - Sistema Veterinaria</title>
</head>
<body class="bg-gray-100 min-h-screen">
  <slot />
</body>
</html>
